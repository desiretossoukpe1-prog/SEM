INPUT INSTRUCTIONS

  TITLE: FINAL AT LARGE PROJECT SEM MEDIATION

  DATA: FILE = dataset11.csv;

  VARIABLE:
    NAMES ARE IDTEACH
              TT3G34D TT3G34F TT3G34H
              TT3G41A TT3G41BR TT3G41C TT3G41D
              TT3G52F TT3G52G TT3G52H
              TT3G34I TT3G01 TT3G11B;
    USEVARIABLES = TT3G41A TT3G41BR TT3G41C TT3G41D
                   TT3G52F TT3G52G TT3G52H
                   TT3G34D TT3G34F TT3G34H TT3G34I
                   TT3G01 TT3G11B;
    IDVARIABLE = IDTEACH;
    MISSING = ALL (-99);

  DEFINE:
    STANDARDIZE TT3G11B;   ! z-scores (mean 0, SD 1)

  ANALYSIS:
    ESTIMATOR = MLR;

  MODEL:
    ! Measurement model
    FDISC  BY TT3G41A TT3G41BR TT3G41C TT3G41D;
    FSTBEH BY TT3G52F TT3G52G TT3G52H;
    FSECLS BY TT3G34D TT3G34F TT3G34H TT3G34I;

    ! Mediator (stress) predicted by climate and controls
    FSTBEH ON FDISC (a)
              TT3G01
              TT3G11B;

    ! Outcome (self-efficacy) predicted by stress, climate and controls
    FSECLS ON FSTBEH (b)
              FDISC (cprime)
              TT3G01
              TT3G11B;

    ! Covariances among exogenous variables
    ! (keeps teachers with missing controls in the analysis)
    FDISC WITH TT3G01 TT3G11B;
    TT3G01 WITH TT3G11B;

  MODEL INDIRECT:
    FSECLS IND FDISC;

  OUTPUT: STDYX TECH1;



*** WARNING
  Data set contains cases with missing on all variables except
  x-variables.  These cases were not included in the analysis.
  Number of cases with missing on all variables except x-variables:  5983
